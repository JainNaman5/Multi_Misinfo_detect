{
  "version": 2,
  "builds": [
    {
      "src": "backend/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "backend/app.py"
    },
    {
      "src": "/analyze",
      "dest": "backend/app.py"
    },
    {
      "src": "/supported-languages",
      "dest": "backend/app.py"
    },
    {
      "src": "/stats",
      "dest": "backend/app.py"
    },
    {
      "src": "/docs",
      "dest": "backend/app.py"
    },
    {
      "src": "/openapi.json",
      "dest": "backend/app.py"
    },
    {
      "src": "/css/(.*)",
      "dest": "frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "frontend/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ]
}
